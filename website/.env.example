# Copy to .env and fill in. All values are optional; missing values keep features off.
# Final public domain (used for canonical URLs, sitemap, Open Graph)
SITE_URL=https://www.your-domain.com

# Main WhatsApp number, international format without + or spaces (Egypt: 20 + 10 digits)
# Example format only: 201XXXXXXXXX
PUBLIC_WHATSAPP_NUMBER=

# Analytics / marketing (leave empty to disable)
PUBLIC_GA_ID=            # Google Analytics 4, e.g. G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=    # Meta Pixel ID (digits)
PUBLIC_GSC_VERIFICATION= # Google Search Console HTML-tag verification code

# Appointment system: an HTTPS endpoint that accepts POST JSON booking requests.
# If empty, the booking form hands the request to WhatsApp instead.
PUBLIC_BOOKING_ENDPOINT=
