---
import type { Lang } from '../data/branches';
import { branches } from '../data/branches';
import { mainServices, secondaryServices } from '../data/services';
import { media } from '../data/media';
import { site } from '../config/site';
import { t } from '../i18n/ui';
import { localize, routes, whatsappLink, telLink } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BranchCard from '../components/BranchCard.astro';
import Testimonials from '../components/Testimonials.astro';
import BookingForm from '../components/BookingForm.astro';
import TeamSection from '../components/TeamSection.astro';
import Gallery from '../components/Gallery.astro';
import CasesSection from '../components/CasesSection.astro';
import Icon from '../components/Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const h = d.home;
const wa = whatsappLink(d.whatsappDefault);
const valueIcons = ['heart', 'shield', 'users', 'chat', 'star'];

const schema = [{
  '@type': 'WebSite',
  name: lang === 'ar' ? 'عيادات فلوريدا لطب وتقويم الأسنان' : 'Florida Dental Clinics',
  url: new URL(localize('/', lang), Astro.site).href,
  inLanguage: lang === 'ar' ? 'ar-EG' : 'en',
}];
---
<BaseLayout lang={lang} title={d.seo.homeTitle} description={d.seo.homeDesc} schema={schema}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">{h.eyebrow}</p>
        <h1>{h.title}</h1>
        <p class="hero__tagline">{site.tagline[lang]}</p>
        <p class="lead">{h.lead}</p>
        <div class="btn-row hero__cta">
          {wa && <a class="btn" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" />{d.cta.bookWhatsapp}</a>}
          <a class:list={['btn', wa && 'btn--outline']} href={localize(routes.contact, lang) + '#booking'} data-track="book_click"><Icon name="calendar" />{wa ? d.cta.bookForm : d.cta.book}</a>
        </div>
        <dl class="hero__facts">
          {h.facts.map((f) => (
            <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
          ))}
        </dl>
      </div>
      <div class="hero__visual">
        <PhotoSlot src={media.hero ?? undefined} alt={d.placeholder.photo} shape="arch" ratio="4 / 5" motif="smile" loading="eager" />
        <div class="hero__badge" aria-hidden="true">
          <span class="hero__badge-icon"><Icon name="shield" /></span>
          <span>{lang === 'ar' ? site.tagline.shortAr : site.tagline.shortEn}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About + history -->
  <section class="section" aria-labelledby="about-title">
    <div class="container about-intro">
      <div class="reveal">
        <PhotoSlot src={media.homeAbout ?? undefined} alt={d.placeholder.photo} ratio="5 / 4" motif="chair" />
      </div>
      <div class="reveal" data-delay="1">
        <p class="eyebrow">{h.aboutEyebrow}</p>
        <h2 id="about-title" class="title-mark">{h.aboutTitle}</h2>
        <p class="lead">{h.aboutText}</p>
        <ol class="history" aria-label={h.historyTitle}>
          {branches.map((b) => (
            <li>
              <span class="history__year">{b.opened}</span>
              <a href={localize(routes.branch(b.slug), lang)}>{b.name[lang]}</a>
              {b.isMain && <span class="tag">{d.branches.main}</span>}
            </li>
          ))}
        </ol>
        <a class="link-arrow" href={localize(routes.about, lang)}>{h.aboutLink} <Icon name="arrow" class="flip" /></a>
      </div>
    </div>
  </section>

  <!-- Services: seven numbered cards -->
  <section class="section section--dark" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{h.servicesEyebrow}</p>
        <h2 id="services-title">{h.servicesTitle}</h2>
        <p>{h.servicesLead}</p>
      </div>
      <div class="svc-grid" data-main-services>
        {mainServices.map((s, i) => <ServiceCard lang={lang} service={s} number={i + 1} delay={i % 4} />)}
      </div>
      <div class="svc-more reveal">
        <ul>
          {secondaryServices.map((s) => <li><a href={localize(routes.service(s.slug), lang)}><Icon name={s.icon} />{s.name[lang]}</a></li>)}
        </ul>
        <a class="btn" href={localize(routes.services, lang)}>{d.cta.allServices}</a>
      </div>
    </div>
  </section>

  <!-- Why Florida -->
  <section class="section" aria-labelledby="why-title">
    <div class="container why">
      <div class="why__head reveal">
        <p class="eyebrow">{h.whyEyebrow}</p>
        <h2 id="why-title" class="title-mark">{h.whyTitle}</h2>
        <a class="btn btn--outline" href={localize(routes.about, lang)}>{h.aboutLink}</a>
      </div>
      <ol class="why__list">
        {d.values.map((v, i) => (
          <li class="reveal" data-delay={String(i % 3)}>
            <span class="why__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="why__icon"><Icon name={valueIcons[i]} /></span>
            <div><h3>{v.title}</h3><p>{v.text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <TeamSection lang={lang} />

  <!-- Branches -->
  <section class="section section--sand" aria-labelledby="branches-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">{h.branchesEyebrow}</p>
        <h2 id="branches-title">{h.branchesTitle}</h2>
        <p>{h.branchesLead}</p>
      </div>
      <div class="grid grid--3">
        {branches.map((b, i) => <BranchCard lang={lang} branch={b} delay={i} />)}
      </div>
      <div class="hours-strip reveal">
        <span class="icon-badge"><Icon name="clock" /></span>
        <div>
          <h3>{d.branches.hours}</h3>
          <p>{site.hours.sentence[lang]}</p>
        </div>
        <a class="btn btn--outline" href="#booking" data-track="book_click">{d.cta.book}</a>
      </div>
    </div>
  </section>

  <!-- Patient experience -->
  <section class="section" aria-labelledby="exp-title">
    <div class="container">
      <div class="section-head section-head--center reveal">
        <p class="eyebrow">{h.experienceEyebrow}</p>
        <h2 id="exp-title">{h.experienceTitle}</h2>
      </div>
      <ol class="steps">
        {h.experience.map((s, i) => (
          <li class="reveal" data-delay={String(i)}>
            <span class="steps__num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Gallery lang={lang} />
  <CasesSection lang={lang} />
  <Testimonials lang={lang} />

  <!-- Contact + appointment request -->
  <section class="section section--dark home-booking" id="booking" aria-labelledby="booking-title">
    <div class="container home-booking__grid">
      <div class="reveal">
        <p class="eyebrow">{h.bookingEyebrow}</p>
        <h2 id="booking-title" class="title-mark">{h.bookingTitle}</h2>
        <p class="lead">{h.bookingText}</p>
        {wa && <a class="btn" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" />{d.cta.bookWhatsapp}</a>}
        <ul class="home-booking__phones">
          {branches.map((b) => b.phone && (
            <li><span>{b.name[lang]}</span><a href={telLink(b.phone)} dir="ltr" data-track="call_click">{b.phone}</a></li>
          ))}
        </ul>
        <p class="home-booking__hours"><Icon name="clock" />{site.hours.lines[lang].join(lang === 'ar' ? '، ' : ' · ')}</p>
      </div>
      <div class="booking-card reveal" data-delay="1">
        <h3>{d.contact.formTitle}</h3>
        <BookingForm lang={lang} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; padding-block: clamp(32px, 5vw, 72px) clamp(56px, 8vw, 104px); background: linear-gradient(180deg, var(--ivory), var(--white)); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset-inline-start: -200px; top: 40%; width: 520px; height: 520px; border-radius: 50%; border: 1px solid var(--gold-200); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: clamp(40px, 6vw, 72px); align-items: center; }
  @media (min-width: 960px) { .hero__grid { grid-template-columns: 1.1fr .9fr; } }
  .hero h1 { max-width: 15ch; margin-bottom: .4em; }
  :global(html[lang='en']) .hero h1 { max-width: 16ch; }
  .hero__tagline { margin: 0 0 14px; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 500; color: var(--gold-700); }
  .hero__cta { margin-top: 32px; }
  .hours-strip { display: grid; gap: 18px; align-items: center; margin-top: 28px; padding: 24px 28px; border-radius: var(--radius-lg); background: var(--white); border: 1px solid var(--line); }
  .hours-strip .icon-badge { margin: 0; }
  .hours-strip h3 { margin-bottom: .15em; }
  .hours-strip p { margin: 0; color: var(--ink-2); }
  @media (min-width: 800px) { .hours-strip { grid-template-columns: auto 1fr auto; } }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 16px 40px; margin: 44px 0 0; padding-top: 28px; border-top: 1px solid var(--line); }
  .hero__facts div { display: flex; flex-direction: column-reverse; }
  .hero__facts dd { margin: 0; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 2.4rem; font-weight: 600; line-height: 1.1; color: var(--gold-700); }
  .hero__facts dt { color: var(--ink-3); font-size: .95rem; }
  .hero__visual { position: relative; max-width: 480px; width: 100%; margin-inline: auto; }
  .hero__visual::before { content: ''; position: absolute; inset: -16px; border-radius: 999px 999px 36px 36px; border: 1px solid var(--gold-300); pointer-events: none; }
  .hero__badge { position: absolute; inset-inline-start: -12px; bottom: 32px; display: flex; align-items: center; gap: 12px; padding: 12px 18px 12px 12px; background: var(--white); border-radius: 999px; box-shadow: var(--shadow); font-weight: 500; font-size: .95rem; }
  [dir='rtl'] .hero__badge { padding: 12px 12px 12px 18px; }
  .hero__badge-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--gold-200); color: var(--gold-700); }
  .hero__badge-icon :global(svg) { width: 20px; height: 20px; }
  @media (max-width: 520px) { .hero__badge { inset-inline-start: 8px; bottom: 18px; font-size: .88rem; } }

  .history { list-style: none; display: grid; gap: 0; margin: 4px 0 24px; border-top: 1px solid var(--line); }
  .history li { display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .history__year { min-width: 3.2ch; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.6rem; font-weight: 600; line-height: 1; color: var(--gold-700); }
  .history a { font-weight: 500; text-decoration: none; }
  .svc-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 28px; }
  .svc-more ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .svc-more li a { display: inline-flex; align-items: center; gap: 10px; padding: 11px 18px; border: 1px solid rgba(198, 151, 65, .45); border-radius: 999px; color: #e6ddcd; text-decoration: none; }
  .svc-more li :global(svg) { width: 18px; height: 18px; color: var(--gold-300); }
  .home-booking { scroll-margin-top: 70px; }
  .home-booking__grid { display: grid; gap: 40px; align-items: start; }
  @media (min-width: 1000px) { .home-booking__grid { grid-template-columns: .8fr 1.2fr; gap: 64px; } }
  .home-booking__phones { list-style: none; display: grid; margin: 28px 0 18px; border-top: 1px solid rgba(255, 255, 255, .14); }
  .home-booking__phones li { display: flex; justify-content: space-between; gap: 16px; padding: 13px 0; border-bottom: 1px solid rgba(255, 255, 255, .14); }
  .home-booking__phones a { color: var(--gold-300); font-weight: 600; text-decoration: none; }
  .home-booking__hours { display: flex; gap: 10px; align-items: flex-start; margin: 0; font-size: .95rem; }
  .home-booking__hours :global(svg) { width: 20px; height: 20px; margin-top: .3em; color: var(--gold-300); flex: none; }
  .booking-card { background: var(--white); color: var(--ink); border-radius: var(--radius-lg); padding: clamp(22px, 3vw, 36px); box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .7); }
  .booking-card h3 { color: var(--ink); margin-bottom: 18px; }
  .booking-card :global(a:not(.btn):hover) { color: var(--gold-700); }
  .about-intro { display: grid; gap: clamp(32px, 5vw, 72px); align-items: center; }
  @media (min-width: 900px) { .about-intro { grid-template-columns: 1fr 1fr; } }

  .why { display: grid; gap: 40px; }
  @media (min-width: 960px) { .why { grid-template-columns: .8fr 1.2fr; gap: 72px; } .why__head { position: sticky; top: 110px; align-self: start; } }
  .why__head h2 { margin-bottom: 28px; }
  .why__list { list-style: none; display: grid; }
  .why__list li { display: grid; grid-template-columns: auto auto 1fr; gap: 18px; align-items: start; padding-block: 26px; border-top: 1px solid var(--line); }
  .why__list li:last-child { border-bottom: 1px solid var(--line); }
  .why__num { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.1rem; color: var(--gold-600); padding-top: .2em; min-width: 2ch; }
  .why__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--ivory); color: var(--gold-600); border: 1px solid var(--gold-200); }
  .why__icon :global(svg) { width: 22px; height: 22px; }
  .why__list h3 { margin-bottom: .2em; }
  .why__list p { margin: 0; color: var(--ink-2); }

  .steps { list-style: none; display: grid; gap: 20px; counter-reset: s; }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1080px) { .steps { grid-template-columns: repeat(4, 1fr); } }
  .steps li { position: relative; padding: 28px; border-radius: var(--radius-lg); background: var(--ivory); border: 1px solid var(--line); }
  .steps__num { display: grid; place-items: center; width: 44px; height: 44px; margin-bottom: 18px; border-radius: 50%; background: var(--ink); color: var(--gold-300); font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.3rem; font-weight: 600; }
  .steps p { margin: 0; color: var(--ink-2); }
</style>
