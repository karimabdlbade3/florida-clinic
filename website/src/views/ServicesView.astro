---
import type { Lang } from '../data/branches';
import { services, mainServices, secondaryServices } from '../data/services';
import { t } from '../i18n/ui';
import { localize, routes } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const schema = [{
  '@type': 'ItemList',
  name: d.services.title,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name[lang],
    url: new URL(localize(routes.service(s.slug), lang), Astro.site).href,
  })),
}];
---
<BaseLayout lang={lang} title={d.seo.servicesTitle} description={d.seo.servicesDesc} schema={schema}>
  <PageHero lang={lang} title={d.services.title} lead={d.services.lead} crumbs={[{ label: d.services.title }]} />
  <section class="section section--dark" aria-labelledby="main-services">
    <div class="container">
      <h2 id="main-services" class="sr-only">{d.services.title}</h2>
      <div class="svc-grid" data-main-services>
        {mainServices.map((s, i) => <ServiceCard lang={lang} service={s} number={i + 1} delay={i % 4} eager={i < 2} />)}
      </div>
    </div>
  </section>
  {secondaryServices.length > 0 && (
    <section class="section" aria-labelledby="secondary-services">
      <div class="container">
        <div class="section-head reveal">
          <h2 id="secondary-services">{d.services.secondaryTitle}</h2>
          <p>{d.services.secondaryLead}</p>
        </div>
        <div class="svc-grid svc-grid--few" data-secondary-services>
          {secondaryServices.map((s, i) => <ServiceCard lang={lang} service={s} delay={i} />)}
        </div>
        <p class="muted" style="margin-top:40px;font-size:.92rem">{d.services.note}</p>
      </div>
    </section>
  )}
  <CtaBand lang={lang} title={d.services.ctaTitle} text={d.services.ctaText} />
</BaseLayout>
