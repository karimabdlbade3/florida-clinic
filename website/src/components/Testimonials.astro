---
/**
 * Patient reviews. Shows genuine, consented reviews only (src/data/testimonials.ts).
 * Renders nothing when there are none for this language: never fake quotes.
 */
import type { Lang } from '../data/branches';
import { testimonials } from '../data/testimonials';
import { services } from '../data/services';
import { branches } from '../data/branches';
import { t } from '../i18n/ui';
import { localize, routes } from '../lib/urls';
import Icon from './Icon.astro';
interface Props { lang: Lang; limit?: number; page?: boolean }
const { lang, limit = 3, page = false } = Astro.props;
const d = t(lang).reviews;
const all = [...testimonials.filter((x) => x.lang === lang), ...testimonials.filter((x) => x.lang !== lang)];
const list = page ? all : all.slice(0, limit);
const serviceName = (slug?: string) => services.find((s) => s.slug === slug)?.name[lang];
const branchName = (slug?: string) => branches.find((b) => b.slug === slug)?.name[lang];
const fmtDate = (v?: string) => {
  if (!v) return null;
  const dt = new Date(v.length === 7 ? v + '-01' : v);
  return isNaN(+dt) ? null : new Intl.DateTimeFormat(lang === 'ar' ? 'ar-EG' : 'en-GB', { year: 'numeric', month: 'long' }).format(dt);
};
---
{list.length > 0 && (
  <section class:list={['section', !page && 'section--ivory']} aria-labelledby="reviews-title">
    <div class="container">
      {!page && (
        <div class="section-head reveal">
          <p class="eyebrow">{d.eyebrow}</p>
          <h2 id="reviews-title">{d.title}</h2>
        </div>
      )}
      {page && <h2 id="reviews-title" class="sr-only">{d.title}</h2>}
      <div class="grid grid--3" data-reviews>
        {list.map((x, i) => (
          <figure class="card review reveal" data-delay={String(i % 3)}>
            <span class="review__mark" aria-hidden="true">”</span>
            {x.rating && <p class="review__stars" role="img" aria-label={d.ratingLabel(x.rating)}>{'★'.repeat(x.rating)}<span>{'★'.repeat(5 - x.rating)}</span></p>}
            <blockquote lang={x.lang} dir={x.lang === 'ar' ? 'rtl' : 'ltr'}><p>{x.quote}</p></blockquote>
            <figcaption>
              <span class="review__name">{x.name ?? d.anonymous}</span>
              <span class="review__meta">{[serviceName(x.service), branchName(x.branch), fmtDate(x.date)].filter(Boolean).join(' · ')}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      {!page && all.length > list.length && (
        <p style="margin-top:28px"><a class="btn btn--outline" href={localize(routes.reviews, lang)}>{d.viewAll} <Icon name="arrow" class="flip" /></a></p>
      )}
    </div>
  </section>
)}

<style>
  .review { display: flex; flex-direction: column; margin: 0; }
  .review__mark { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 4rem; line-height: .6; color: var(--gold-400); height: 34px; }
  .review__stars { margin: 0 0 10px; color: var(--gold-500); letter-spacing: 2px; }
  .review__stars span { color: var(--line); }
  .review blockquote { margin: 0 0 20px; flex: 1; }
  .review blockquote p { color: var(--ink); font-size: 1.02rem; margin: 0; white-space: pre-line; }
  .review figcaption { display: grid; gap: 2px; padding-top: 16px; border-top: 1px solid var(--line); }
  .review__name { font-weight: 600; }
  .review__meta { color: var(--ink-3); font-size: .9rem; }
</style>
