---
/**
 * TEMPORARY wordmark. Replace with the official Florida logo files
 * (SVG preferred) in /public/brand/ and swap this component's markup.
 */
import type { Lang } from '../data/branches';
interface Props { lang: Lang; tone?: 'dark' | 'light' }
const { lang, tone = 'dark' } = Astro.props;
---
<span class:list={['logo', `logo--${tone}`]}>
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1" opacity=".55" />
    <path d="M14.5 11.5c-2.6 0-4.1 2-4.1 4.6 0 2.1.9 3.5 1.4 5.3.6 2.3.7 7.1 2.6 7.1 1.6 0 1.5-4.4 2.9-5.4.4-.3.6-.4 1.6-.4h2.2c1 0 1.2.1 1.6.4 1.4 1 1.3 5.4 2.9 5.4 1.9 0 2-4.8 2.6-7.1.5-1.8 1.4-3.2 1.4-5.3 0-2.6-1.5-4.6-4.1-4.6-1.9 0-2.8 1.1-4.6 1.1s-2.6-1.1-4.4-1.1z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
  </svg>
  <span class="logo__text">
    <span class="logo__name">FLORIDA</span>
    <span class="logo__sub">{lang === 'ar' ? 'لطب وتقويم الأسنان' : 'DENTAL CLINICS'}</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .logo--light { color: var(--white); }
  .logo__mark { width: 40px; height: 40px; color: var(--gold-500); flex: none; }
  .logo__text { display: grid; line-height: 1; }
  .logo__name { font-family: 'Cormorant Garamond', Georgia, serif; font-weight: 600; font-size: 1.45rem; letter-spacing: .22em; direction: ltr; }
  .logo__sub { margin-top: 4px; font-size: .68rem; letter-spacing: .12em; color: var(--gold-700); }
  .logo--light .logo__sub { color: var(--gold-300); }
  :global(html[lang='ar']) .logo__sub { letter-spacing: 0; font-size: .74rem; }
  @media (max-width: 520px) {
    .logo { gap: 8px; }
    .logo__mark { width: 32px; height: 32px; }
    .logo__name { font-size: 1.12rem; letter-spacing: .16em; }
    .logo__sub { font-size: .6rem; }
  }
</style>
