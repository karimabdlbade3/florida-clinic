---
/**
 * Service card. Dark card with the service photo as a darkened background.
 * `number` shows the gold index (01, 02, ...) used for the seven main services.
 */
import { Picture } from 'astro:assets';
import type { Lang } from '../data/branches';
import type { Service } from '../data/services';
import { media } from '../data/media';
import { t } from '../i18n/ui';
import { localize, routes } from '../lib/urls';
import Icon from './Icon.astro';
interface Props { lang: Lang; service: Service; number?: number; delay?: number }
const { lang, service, number, delay = 0 } = Astro.props;
const d = t(lang);
const img = media.services[service.slug];
---
<article class="svc-card reveal" data-delay={String(delay % 4)}>
  {img && <Picture class="svc-card__img" src={img} alt="" formats={['avif', 'webp']} widths={[420, 760]} sizes="(min-width: 1024px) 560px, (min-width: 640px) 50vw, 100vw" loading="lazy" />}
  <div class="svc-card__body">
    {number
      ? <span class="svc-card__num" aria-hidden="true">{String(number).padStart(2, '0')}</span>
      : <span class="svc-card__icon"><Icon name={service.icon} /></span>}
    <h3><a class="stretched" href={localize(routes.service(service.slug), lang)}>{service.name[lang]}</a></h3>
    <p>{service.short[lang]}</p>
    <span class="link-arrow" aria-hidden="true">{d.cta.learnMore} <Icon name="arrow" class="flip" /></span>
  </div>
</article>

<style>
  .svc-card { position: relative; display: flex; min-height: 290px; overflow: hidden; border-radius: var(--radius-lg); border: 1px solid rgba(198, 151, 65, .45); background: #1f1c16; color: #e6ddcd; isolation: isolate; transition: transform .35s var(--ease), border-color .35s var(--ease), box-shadow .35s var(--ease); }
  .svc-card:hover { transform: translateY(-4px); border-color: var(--gold-400); box-shadow: 0 24px 50px -28px rgba(0, 0, 0, .8); }
  .svc-card :global(.svc-card__img), .svc-card :global(picture) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; }
  .svc-card :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) brightness(.72) contrast(1.05); transition: transform .8s var(--ease); }
  .svc-card:hover :global(img) { transform: scale(1.05); }
  .svc-card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(20, 18, 14, .4) 0%, rgba(20, 18, 14, .74) 45%, rgba(20, 18, 14, .95) 100%); }
  .svc-card__body { display: flex; flex-direction: column; align-items: flex-start; width: 100%; padding: clamp(22px, 2.6vw, 30px); }
  .svc-card__num { font-family: 'Cormorant Garamond', Georgia, serif; font-size: clamp(3rem, 2.4rem + 1.6vw, 4rem); font-weight: 600; line-height: 1; color: var(--gold-400); margin-bottom: auto; padding-bottom: 28px; }
  .svc-card__icon { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: auto; border-radius: 50%; border: 1px solid rgba(198, 151, 65, .5); color: var(--gold-300); }
  .svc-card__icon :global(svg) { width: 26px; height: 26px; }
  .svc-card h3 { margin: 18px 0 .35em; color: var(--white); }
  .svc-card h3 a { color: inherit; text-decoration: none; }
  .svc-card p { margin: 0 0 18px; color: #d6ccba; font-size: .97rem; }
  .svc-card .link-arrow { color: var(--gold-300); margin-top: auto; }
</style>
