---
import type { Lang } from '../data/branches';
import { t } from '../i18n/ui';
import { site } from '../config/site';
import { localize, routes, whatsappLink } from '../lib/urls';
import Icon from './Icon.astro';
interface Props { lang: Lang; title?: string; text?: string; bookHref?: string; waMessage?: string; waNumber?: string | null }
const { lang, title, text, bookHref, waMessage, waNumber } = Astro.props;
const d = t(lang);
const wa = whatsappLink(waMessage ?? d.whatsappDefault, waNumber);
---
<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <p class="eyebrow" style="color:var(--gold-300)">{site.brand[lang]}</p>
      <h2>{title ?? d.home.finalTitle}</h2>
      <p>{text ?? d.home.finalText}</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn" href={bookHref ?? localize(routes.contact, lang) + '#booking'} data-track="book_click"><Icon name="calendar" />{d.cta.book}</a>
        {wa && <a class="btn btn--light" href={wa} target="_blank" rel="noopener" data-track="whatsapp_click"><Icon name="whatsapp" />{d.cta.whatsapp}</a>}
      </div>
    </div>
  </div>
</section>
